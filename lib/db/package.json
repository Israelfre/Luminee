{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "dotenv -e ../../.env -- ./node_modules/drizzle-kit/bin.cjs push --config ./drizzle.config.ts",
    "push-force": "dotenv -e ../../.env -- ./node_modules/drizzle-kit/bin.cjs push --force --config ./drizzle.config.ts",
    "migrate": "./node_modules/drizzle-kit/bin.cjs migrate --config ./drizzle.config.ts",
    "migrations": "./node_modules/drizzle-kit/bin.cjs migrate --config ./drizzle.config.ts",
    "db:migrate": "./node_modules/drizzle-kit/bin.cjs migrate --config ./drizzle.config.ts",
    "db:push": "dotenv -e ../../.env -- ./node_modules/drizzle-kit/bin.cjs push --config ./drizzle.config.ts",
    "generate": "dotenv -e ../../.env -- ./node_modules/drizzle-kit/bin.cjs generate --config ./drizzle.config.ts",
    "db:generate": "dotenv -e ../../.env -- ./node_modules/drizzle-kit/bin.cjs generate --config ./drizzle.config.ts",
    "studio": "dotenv -e ../../.env -- ./node_modules/drizzle-kit/bin.cjs studio --config ./drizzle.config.ts",
    "db:studio": "dotenv -e ../../.env -- ./node_modules/drizzle-kit/bin.cjs studio --config ./drizzle.config.ts",
    "check": "dotenv -e ../../.env -- ./node_modules/drizzle-kit/bin.cjs check --config ./drizzle.config.ts",
    "db:check": "dotenv -e ../../.env -- ./node_modules/drizzle-kit/bin.cjs check --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.9"
  }
}
