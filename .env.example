# ==============================
# Luminee — Environment Variables
# ==============================
# Copy this file to .env and fill in the values.
# In production (Render), set these in the Render Dashboard or render.yaml.

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/luminee

# --- Server ---
PORT=8080
NODE_ENV=development

# --- Auth (session) ---
# Random secret for signing session cookies — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# --- Admin Panel ---
# Credentials for the /admin route
ADMIN_EMAIL=admin@luminee.com
ADMIN_PASSWORD=admin40028922

# --- Demo Salon (seed) ---
# Password for the demo salon created on first run
DEMO_SALON_PASSWORD=demo123456

# --- Clerk (OPTIONAL) ---
# Leave blank to use email+password auth only.
# Fill in if you want Clerk SSO (Google/GitHub/etc.)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
