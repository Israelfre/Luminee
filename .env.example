# Copie para `.env` na raiz (gitignored). Carregado pela API (`load-env`) e pelo Vite (`loadEnv` na raiz).
# Não commite o `.env` nem coloque senhas reais em ficheiros versionados.

# --- Database (Supabase) ---
# Conexão via pooler (PgBouncer, porta 6543) — usada em runtime pela API (compatível com serverless/Vercel).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA_AQUI@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Conexão direta (porta 5432) — usada apenas para rodar migrations (drizzle-kit), nunca pelo pooler.
DIRECT_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA_AQUI@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Opcional: com CA válido no Postgres, `true` força validação SSL estrita.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- API ---
PORT=8080
NODE_ENV=development

# --- Auth (session) ---
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# --- Admin (obrigatório no primeiro `pnpm db:seed` se ainda não existir admin) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Salão demo (opcional — seed pula se não definido) ---
DEMO_SALON_EMAIL=
DEMO_SALON_PASSWORD=

# --- CORS (produção) ---
# Lista de origens permitidas, separadas por vírgula.
# Ex.: https://luminee-api.onrender.com,https://meudominio.com
# Se vazio, aceita qualquer origem (ok quando o front é servido pelo mesmo serviço).
ALLOWED_ORIGINS=

# --- Front (Vite) ---
# Porta do Vite em dev (default 5173). A API usa PORT acima; o proxy /api aponta para essa porta.
VITE_PORT=5173
# Dev: só se a API não estiver em localhost:PORT (ex.: outro host).
# VITE_DEV_API_TARGET=http://localhost:8080

# Produção (build estático no Render): base da API **sem** `/api`.
# Ex.: https://luminee-api.onrender.com
# VITE_API_URL=http://localhost:8080
